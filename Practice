#calculator
def main():
    print("Welcome to the calculator!")
    while True:
        try:
            expression = input("Enter an expression (or type 'exit' to quit): ")
            if expression.lower() == 'exit':
                print("Goodbye!")
                break
            result = eval(expression)
            print(f"Result: {result}")
        except Exception as e:
            print(f"Error: {e}")

if __name__ == "__main__":
    main()

