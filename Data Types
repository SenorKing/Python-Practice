def print_variable_info(v):
    print("Value = ", v, "Type = ", type(v), "ID = ", id(v))


def describe_value(v):
    if type(v) is int:
        return "Integer"
    elif type(v) is float:
        return "Float"
    elif type(v) is str:
        return "String"
    elif type(v) is bool:
        return "Boolean"
    elif type(v) is list:
        return "List"
    elif type(v) is tuple:
        return "Tuple"
    elif type(v) is dict:
        return "Dictionary"
    elif type(v) is None:
        return "None"
    else:
        return "Other Type"

