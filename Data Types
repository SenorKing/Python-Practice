class student:
    name = None
    student_id = None
    major = None
    credits = None

    def __init__(self, name, student_id, major, credits):
        self.name = name
        self.student_id = student_id
        self.major = major
        self.credits = credits

    def display_info(self):
        print("Name : ", self.name, "StudentID : ", self.student_id, "Major : ", self.major, "Credits : ", self.credits)

    def addCredits(self, credit):
        self.credits += credit

    def isSenior(self):
        return self.credits >= 90


